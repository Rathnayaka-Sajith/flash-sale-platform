datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Order {
  id          String      @id
  totalPaid   Float
  timestamp   String
  items       OrderItem[]
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id])
  productId String
  quantity  Int
  price     Float
}